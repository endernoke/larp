{
  "name": "larp",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "npm run check:svelte && biome check .",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "fix": "biome check --write .",
