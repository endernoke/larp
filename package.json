    "svelte": "5.56.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/seedrandom": "^3.0.8",
    "svelte-check": "^4.3.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.2",
    "vite": "8.1.5"
  }
